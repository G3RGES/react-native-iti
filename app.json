{
  "expo": {
    "name": "Foody Recipes",
    "slug": "foody-recipes",
    "version": "1.0.0",

    "web": {
      "favicon": "./assets/favicon (2).png"
    },

    "experiments": {
      "tsconfigPaths": true
    },

    "plugins": [],

    "orientation": "portrait",
    "icon": "./assets/favicon (2).png",

    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash (2).png",
      "resizeMode": "contain",
      "backgroundColor": "#eef3f6",
      "border": "none",

      "assetBundlePatterns": ["**/*"],
      "ios": {
        "supportsTablet": true,
        "splash": {
          "image": "./assets/splash (2).png",
          "resizeMode": "contain",
          "backgroundColor": "#eef3f6",
          "border": "none"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon (2).png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/splash (2).png",
        "resizeMode": "contain",
        "backgroundColor": "#eef3f6",
        "border": "none"
      }
    }
  }
}
